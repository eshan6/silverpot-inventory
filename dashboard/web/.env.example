# The anon key is designed to be public: it identifies the project, and row
# level security decides what the signed-in user may read. The service key
# never appears here, in the browser, or anywhere a build can reach it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
